# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.spec

# ── Virtual environments ────────────────────────────────────────────────────────
.venv/
venv/
env/
.env.bak

# ── Environment / secrets ──────────────────────────────────────────────────────
# Keep .env.example but never commit the real .env (contains API keys)
.env
!.env.example

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Test & coverage ────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.xml
junit*.xml

# ── Logs & output ─────────────────────────────────────────────────────────────
*.log
output.txt
output_act.txt
logs/

# ── Mirror (cloned repos — large, not part of the tool source) ────────────────
mirror/

# ── Docker volumes (if bind-mounted locally) ──────────────────────────────────
neo4j_data/
chroma_data/
redis_data/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Byte-compiled / type stubs ────────────────────────────────────────────────
*.pyi
py.typed

# ── MyPy / Pyright caches ─────────────────────────────────────────────────────
.mypy_cache/
.pyright/
pyrightconfig.json

# ── Packaging / distribution ──────────────────────────────────────────────────
*.whl
*.tar.gz
MANIFEST
