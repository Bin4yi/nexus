# ── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexuspassword

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Paths ────────────────────────────────────────────────────────────────────
REPOS_MIRROR_PATH=./mirror
REPOS_CONFIG_PATH=./sample_repos/repos.yaml

# ── LLM ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here

# Base model — used for bulk ops (community summarization, map scoring).
# Cheapest model that can produce structured summaries.
LLM_MODEL=gpt-4o-mini

# ── Model overrides for crucial steps ────────────────────────────────────────
# LLM_QUERY_MODEL  : final answer generation (what the developer reads)
# LLM_PARSER_MODEL : query parsing — entity extraction, intent, typo fixing
#
# Set these to your best available model for higher answer quality.
# Leave empty to fall back to LLM_MODEL.
#
# Examples (verify exact names in your OpenAI dashboard):
#   gpt-4o-mini   — fast, cheap, good for structured output
#   gpt-4o        — smarter, better code understanding
#   gpt-4.1-mini  — latest mini family
#   o4-mini       — reasoning model, very strong for code tasks
#   gpt-5-mini    — set this when available in your account
LLM_QUERY_MODEL=gpt-4o-mini
LLM_PARSER_MODEL=gpt-4o-mini

# ── GraphRAG / GDS ───────────────────────────────────────────────────────────
GDS_GRAPH_NAME=codenexus-graph
MAX_CONTEXT_TOKENS=32000
REFLECTION_MAX_ITERATIONS=2
COMMUNITY_SUMMARIZATION_ENABLED=true

# ── Hybrid Router ────────────────────────────────────────────────────────────
# ripgrep | git_grep | python
GREP_BACKEND=ripgrep
GREP_MAX_HITS=50
BLAST_RADIUS_DEPTH=3
ROUTER_CONFIDENCE_THRESHOLD=0.7

# ── Leiden Community Detection ───────────────────────────────────────────────
LEIDEN_MAX_LEVELS=10
LEIDEN_GAMMA=1.5
LEIDEN_THETA=0.01
LEIDEN_WRITE_PROPERTY=community_id
# Strict whitelist — ONLY execution/structural edges, NO utility fan-out edges.
# Excluded: THROWS, RETURNS, RECEIVES, INSTANTIATES, HANDLES_EVENT, ANNOTATED_WITH
GDS_LEIDEN_RELATIONSHIPS=CALLS,INJECTS,IMPLEMENTS,EXTENDS,DEPENDS_ON,DECLARES,HAS_METHOD,REMOTE_CALLS,OVERRIDES

# ── Community Summarization ──────────────────────────────────────────────────
SUMMARIZER_MAX_WORKERS=4
COMMUNITY_SUMMARY_MAX_TOKENS=1000

# ── Batch Processing (Scale) ────────────────────────────────────────────────
BATCH_SIZE=500
MAX_CONCURRENT_REPOS=5
PARSER_FILE_BATCH_SIZE=200

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=25

# ── Chunking (Sprint 1 — AST-aware sliding window) ───────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=128

# ── FastEmbed / GPU (Sprint 1) ───────────────────────────────────────────────
# Set USE_FASTEMBED=true after: pip install fastembed-gpu onnxruntime-gpu
USE_FASTEMBED=false
FASTEMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# ── OSGi (Sprint 2) ──────────────────────────────────────────────────────────
OSGI_ENABLED=true

# ── RFC Specification Grounding (Sprint 4) ───────────────────────────────────
# Place RFC markdown files under this directory to enable spec grounding
RFC_PATH=./rfcs

# ── Ollama / Local LLM micro-drafts (Sprint 4) ───────────────────────────────
# Set LOCAL_DRAFTING_ENABLED=true after starting Ollama: ollama run llama3.2
LOCAL_DRAFTING_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Resilience ───────────────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1.0

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s  %(levelname)-8s  %(name)s — %(message)s
